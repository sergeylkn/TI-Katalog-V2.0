{
  "expo": {
    "name": "Тренировка дня",
    "slug": "workout-timer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0F13",
    "splash": {
      "backgroundColor": "#0E0F13",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.workout.timerapp",
      "versionCode": 1,
      "permissions": ["VIBRATE"]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
